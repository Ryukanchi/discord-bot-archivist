# Local configuration file with the secret keys
.env

# Folder with all installed packages (is regenerated with 'npm install')
/node_modules

# SQLite database files and data-bearing sidecars
*.db
*.db-wal
*.db-shm
*.db-journal

# Log files and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS specific
.DS_Store

# VS Code workspace settings (optional, keeps your local setup private)
.vscode/

# Temporary or backup files
*.tmp
*.bak

# Generated local privacy salt
.privacy_salt
