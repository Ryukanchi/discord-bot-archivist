# Discord Community Archivist configuration
# Copy this file to .env and replace the placeholder values.

# Required: Discord application bot token
DISCORD_TOKEN=your_bot_token_here

# Recommended: generate a random 32-byte hex string.
# Example: openssl rand -hex 32
PRIVACY_SALT=your_random_secret_salt_here

# Optional: local SQLite database path
DATABASE_PATH=./highlights.db

# Optional: displayed presence
BOT_STATUS=online
BOT_ACTIVITY_NAME=Community Highlights
BOT_ACTIVITY_TYPE=WATCHING

# Optional: use a development guild for faster slash command registration
DEV_GUILD_ID=

# Highlight detection defaults
SENTIMENT_THRESHOLD=0.3
REACTION_THRESHOLD=3
REPLY_THRESHOLD=2
MIN_SCORE=0.6

# Privacy and retention
DATA_RETENTION_DAYS=30
AUTO_DELETE_ENABLED=true

# Moment of the Day
MOTD_ENABLED=false
MOTD_CHANNEL_ID=
MOTD_POST_HOUR=12

# Comma-separated keywords that add signal to the highlight score
KEYWORDS=lol,haha,omg,wtf,epic,amazing,wow
