# Discord Community Archivist configuration
# Copy this file to .env and replace the placeholder values.

# Required: Discord application bot token
DISCORD_TOKEN=your_bot_token_here

# Required: the only Discord server this Archivist instance may process.
ALLOWED_GUILD_ID=your_server_id_here

# One-time migration only: if an existing non-empty database predates server
# binding, set this to the same value as ALLOWED_GUILD_ID for its first start.
# Remove it again after the database has started successfully.
LEGACY_GUILD_ID=

# Optional: keep this line commented out to generate a private salt automatically.
# For a managed secret, uncomment it and use: openssl rand -hex 32
# Keep the same salt for the lifetime of an existing database.
# PRIVACY_SALT=

# Optional: local SQLite database path. A dedicated private directory is recommended.
DATABASE_PATH=./highlights.db

# Optional: displayed presence
BOT_STATUS=online
BOT_ACTIVITY_NAME=Community Highlights
BOT_ACTIVITY_TYPE=WATCHING

# Deprecated compatibility alias for ALLOWED_GUILD_ID.
DEV_GUILD_ID=

# Highlight detection defaults
REACTION_THRESHOLD=3
MIN_SCORE=0.6

# Privacy and retention
DATA_RETENTION_DAYS=30
AUTO_DELETE_ENABLED=true

# Moment of the Day
MOTD_ENABLED=false
MOTD_CHANNEL_ID=
MOTD_POST_HOUR=12

# Comma-separated keywords that add signal to the highlight score
KEYWORDS=lol,haha,omg,wtf,epic,amazing,wow
